# ==========================================
# CONFIGURACIÓN DEL BACKEND (asesor-digital)
# ==========================================

# 1. Clave de la API de Gemini (OBLIGATORIO)
# Obtén tu clave en: https://aistudio.google.com/
# NUNCA expongas esta clave en el frontend ni la subas a GitHub.
GEMINI_API_KEY=tu_gemini_api_key_aqui

# 2. Modelo de Gemini
GEMINI_MODEL=gemini-2.5-flash

# 3. URL base del Motor de Perfilamiento (sin slash final)
MOTOR_API_URL=http://localhost:8000

# 4. Puerto donde se ejecutará el servidor Node.js
PORT=3001

# ==========================================
# SEGURIDAD Y AJUSTES (OPCIONALES)
# ==========================================

# Orígenes permitidos por CORS (usa '*' para permitir cualquier origen o especifica dominios separados por coma)
ALLOWED_ORIGIN=*

# API Key opcional para proteger el endpoint /api/chat contra usos no autorizados.
# Si se deja vacía, el endpoint estará abierto para pruebas de la hackathon.
CHAT_API_KEY=

# Límite de peticiones por IP para prevenir consumo excesivo de la cuota de Gemini
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
